# Copy this file to .env and replace the placeholder.
# Generate a secret with: openssl rand -hex 32
SEEDR_SESSION_SECRET=replace_with_a_long_random_secret
HOST_PORT=3000

# Keep cache-only enabled by default to avoid live metadata API calls.
CACHE_ONLY_MODE=true

# If you access the app through a different public origin, add it here.
# Example: CORS_ORIGINS=https://your-domain.example
CORS_ORIGINS=http://localhost:3000

# Optional API credentials are configured server-side only when needed:
# TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
# WATCHMODE_API_KEY=
# Optional: enables the NexStream source next to VidRift in the player.
# NEXSTREAM_API_KEY=
# WATCHMODE_API_KEYS=
# OMDB_API_KEY=
# OMDB_API_KEYS=
# VidRift embeds need no API key.

# Size window for MOVIE torrents shown on the Prepare card (series are never size-filtered). Leave unset to use search_limits.json
# (250 MB .. 2 GB). Decimals are fine. Restart the container after changing; no rebuild needed.
# The backend filters with it (search providers, cached lookups) and tells the browser, so both
# sides always agree. Cached torrent files have no upper size limit, so raising the limit
# immediately shows more of what is stored.
# docker compose only passes variables listed under `environment:` in docker-compose.yml, so add
#   TORRENT_MAX_SIZE_GB: "${TORRENT_MAX_SIZE_GB:-}"   (and TORRENT_MIN_SIZE_MB) there, or use `docker run -e`.
# TORRENT_MIN_SIZE_MB=250
# TORRENT_MAX_SIZE_GB=5
