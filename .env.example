# Copy this file to .env and replace the placeholder.
# Generate a secret with: openssl rand -hex 32
SEEDR_SESSION_SECRET=replace_with_a_long_random_secret
HOST_PORT=3000

# Keep cache-only enabled by default to avoid live metadata API calls.
CACHE_ONLY_MODE=true

# If you access the app through a different public origin, add it here.
# Example: CORS_ORIGINS=https://your-domain.example
CORS_ORIGINS=http://localhost:3000

# Optional API credentials are configured server-side only when needed:
# TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
# WATCHMODE_API_KEY=
# Optional: enables the NexStream source next to VidRift in the player.
# NEXSTREAM_API_KEY=
# Optional: enable TorrServer playback from torrent preparation cards.
# Keep TorrServer settings server-side; never add credentials to frontend variables.
TORRSERVER_ENABLED=false
# TorrServer is reached by the backend, not the browser. The URL below assumes
# both containers are attached to the live-torrent-test-net Docker network.
TORRSERVER_URL=http://live-torrent-test-torrserver:8090
# HTTP Basic auth is optional; leave both empty if TorrServer auth is disabled.
TORRSERVER_USERNAME=
TORRSERVER_PASSWORD=
# WATCHMODE_API_KEYS=
# OMDB_API_KEY=
# OMDB_API_KEYS=
# VidRift embeds need no API key.
